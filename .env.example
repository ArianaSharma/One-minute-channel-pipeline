# Copy to .env and fill in. .env is gitignored; never commit real keys.

# mock = no key needed, random answers; live = real TypeSafe API
JEV_MODE=mock
TYPESAFE_API_KEY=

# Optional: enables XAU/USD and NAS100 downloads from Twelve Data
TWELVEDATA_API_KEY=

# Used only by `rig review`
ANTHROPIC_API_KEY=
